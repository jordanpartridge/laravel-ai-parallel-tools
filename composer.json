{
    "name": "jordanpartridge/laravel-ai-parallel-tools",
    "description": "Run opted-in tool calls from one Laravel AI agent step concurrently.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ai",
        "agents",
        "tools",
        "concurrency"
    ],
    "homepage": "https://github.com/jordanpartridge/laravel-ai-parallel-tools",
    "require": {
        "php": "^8.3",
        "illuminate/concurrency": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "laravel/ai": "^1.3",
        "symfony/console": "^7.2|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "nesbot/carbon": "^3.8.4",
        "orchestra/testbench": "^10.6|^11.0",
        "orchestra/testbench-core": "^10.6|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "JordanPartridge\\ParallelTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JordanPartridge\\ParallelTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JordanPartridge\\ParallelTools\\ParallelToolsServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --format agent",
        "test": "pest",
        "test:lint": "pint --test --format agent",
        "test:types": "phpstan --memory-limit=1G",
        "check": [
            "@test:lint",
            "@test:types",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
